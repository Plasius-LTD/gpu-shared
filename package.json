{
  "name": "@plasius/gpu-shared",
  "version": "1.1.1",
  "description": "Shared browser-safe demo runtime and asset helpers for the Plasius gpu-* package family.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "files": [
    "dist",
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "legal"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./feedback-diagnostics": {
      "types": "./src/feedback-diagnostics.d.ts",
      "import": "./dist/feedback-diagnostics.js",
      "require": "./dist/feedback-diagnostics.cjs"
    },
    "./assets/brigantine.gltf": "./assets/brigantine.gltf",
    "./assets/cutter.gltf": "./assets/cutter.gltf",
    "./assets/lighthouse.gltf": "./assets/lighthouse.gltf",
    "./assets/harbor-dock.gltf": "./assets/harbor-dock.gltf",
    "./assets/shoreline.gltf": "./assets/shoreline.gltf",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "demo": "python3 -m http.server --directory ..",
    "demo:example": "node demo/example.js",
    "generate:assets": "node scripts/generate-showcase-assets.mjs",
    "typecheck": "node --check src/index.js && node --check src/feedback-diagnostics.js && node --check src/showcase-runtime.js && node --check src/gltf-loader.js && node --check src/pvox-loader.js && node --check src/product-studio-runtime.js && node --check src/animation-adventure-runtime.js && node --check demo/main.js && tsc -p tsconfig.types.json",
    "zero-three": "node scripts/verify-zero-three.cjs --package --evidence-out release-artifacts/zero-three-evidence.json",
    "zero-three:source": "node scripts/verify-zero-three.cjs --source-only",
    "zero-three:test": "node --test tests/zero-three.test.cjs",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "npm run test:coverage",
    "lint": "eslint . --max-warnings=0 && node --check demo/main.js",
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:privacy": "node --test tests/public-package-policy.test.cjs",
    "test:coverage": "c8 --reporter=lcov --reporter=text node --test",
    "pack:check": "npm run privacy:check && node scripts/verify-public-package.cjs",
    "privacy:check": "node scripts/verify-public-artifacts.cjs --source-only",
    "prepublishOnly": "npm run build && npm run pack:check && npm run zero-three"
  },
  "keywords": [
    "webgpu",
    "gpu",
    "shared",
    "demo",
    "showcase",
    "gltf",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "dependencies": {
    "@plasius/schema": "^1.4.0"
  },
  "peerDependencies": {
    "@plasius/gpu-model-voxel": "^0.1.0",
    "@plasius/gpu-renderer": "^0.2.40",
    "@plasius/translations": "^1.0.23"
  },
  "peerDependenciesMeta": {
    "@plasius/gpu-model-voxel": {
      "optional": true
    },
    "@plasius/gpu-renderer": {
      "optional": true
    },
    "@plasius/translations": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@plasius/gpu-lighting": "^0.2.13",
    "@plasius/translations": "^1.0.23",
    "c8": "^11.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "react": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/gpu-shared.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/gpu-shared/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/gpu-shared#readme",
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "overrides": {
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.1"
  },
  "engines": {
    "node": ">=24"
  }
}
